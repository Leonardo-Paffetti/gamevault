# ==============================================
# GameVault - Environment Configuration Example
# ==============================================
# Copy this file to ".env" and adjust the values
# for your local environment (Laragon default
# values are already set below).

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gamevault
DB_USER=root
DB_PASS=

# --- External API ---
API_BASE_URL=https://www.freetogame.com/api

# --- App ---
APP_ENV=local
APP_TIMEZONE=America/Sao_Paulo
